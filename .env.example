# ─── AWS Cognito & API Gateway Configuration ────────────────────────────────
VITE_AWS_REGION=ap-southeast-2
VITE_COGNITO_USER_POOL_ID=ap-southeast-2_xxxxxxxxx
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-southeast-2.amazonaws.com/v1

# ─── Development & Mock Options ─────────────────────────────────────────────
# Set to 'true' ONLY during local development to use mock in-memory authentication.
# Mock mode is strictly forbidden and disabled in production builds.
VITE_ENABLE_MOCK_AUTH=false
